{
  "name": "equinox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Project Equinox — universal, model-agnostic, self-improving agent harness for local and open-source LLMs",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:lib:host": "pnpm -r --filter \"./packages/**\" run build",
    "build:lib:client": "pnpm --filter @solsticeai/core --filter @solsticeai/client --filter @solsticeai/tools run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}