  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-attachment": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-mcp-client": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-persistence": "workspace:^",
    "@solsticeai/equinox-token-meter": "workspace:^",
    "@solsticeai/equinox-user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-agent-loop": "workspace:^",
    "@solsticeai/equinox-agent-loop-testkit": "workspace:^",
