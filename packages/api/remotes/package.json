{
  "name": "@solsticeai/equinox-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@solsticeai/equinox-deque": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-scope": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent-presets": "workspace:^",
    "@solsticeai/equinox-api-gateway": "workspace:^",
    "@solsticeai/equinox-api-settings-controller": "workspace:^",
    "@solsticeai/equinox-api-workspace-controller": "workspace:^",
    "@solsticeai/equinox-commands": "workspace:^",
    "@solsticeai/equinox-cordis-host-runner": "workspace:^",
    "@solsticeai/equinox-credentials": "workspace:^",
    "@solsticeai/equinox-file-reference": "workspace:^",
    "@solsticeai/equinox-goal": "workspace:^",
    "@solsticeai/equinox-host-plugin-inventory": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-message-feedback": "workspace:^",
    "@solsticeai/equinox-session-reference": "workspace:^",
    "@solsticeai/equinox-settings": "workspace:^",
    "@solsticeai/equinox-subagent": "workspace:^",
    "@solsticeai/equinox-user-approval": "workspace:^",
    "@solsticeai/equinox-user-questions": "workspace:^",
    "@solsticeai/equinox-client-connection": "workspace:^",
    "@solsticeai/equinox-typert-protocol": "workspace:^",
    "@solsticeai/equinox-scope": "workspace:^",
    "@solsticeai/equinox-api-session-controller": "workspace:^"
  }
}
