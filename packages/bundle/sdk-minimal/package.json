{
  "name": "@solsticeai/equinox-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, editor, and JSONL sessions",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@solsticeai/cordis-plugin-timer": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-agent-loop": "workspace:^",
    "@solsticeai/equinox-deepseek-llm-api-extensions": "workspace:^",
    "@solsticeai/equinox-fs-local": "workspace:^",
    "@solsticeai/equinox-invariants": "workspace:^",
    "@solsticeai/equinox-jobs-local": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-llm-deepseek": "workspace:^",
    "@solsticeai/equinox-llm-retry": "workspace:^",
    "@solsticeai/equinox-plugin-package-inventory-deepseek": "workspace:^",
    "@solsticeai/equinox-sandbox-local": "workspace:^",
    "@solsticeai/equinox-sandbox-policy": "workspace:^",
    "@solsticeai/equinox-scope": "workspace:^",
    "@solsticeai/equinox-sdk-app": "workspace:^",
    "@solsticeai/equinox-sdk-jsonrpc-server": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-log-deepseek": "workspace:^",
    "@solsticeai/equinox-session-persistence-jsonl": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^",
    "@solsticeai/equinox-session-title": "workspace:^",
    "@solsticeai/equinox-subprocess-local": "workspace:^",
    "@solsticeai/equinox-system-prompt": "workspace:^",
    "@solsticeai/equinox-terminal": "workspace:^",
    "@solsticeai/equinox-terminal-bash": "workspace:^",
    "@solsticeai/equinox-tool-bash-persistent": "workspace:^",
    "@solsticeai/equinox-tool-pwsh-persistent": "workspace:^",
    "@solsticeai/equinox-tool-str-replace-editor": "workspace:^",
    "@solsticeai/equinox-tools": "workspace:^"
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^"
  }
}
