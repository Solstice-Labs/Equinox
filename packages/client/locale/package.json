{
  "name": "@solsticeai/equinox-client-locale",
  "description": "Locale plugin: Host-backed preference, extensible language catalog, browser fallback, and typed built-in dictionaries",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/client/locale"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-api-remotes": "workspace:^",
    "@solsticeai/equinox-client-store": "workspace:^",
    "@solsticeai/equinox-client-test-runtime": "workspace:^",
    "@solsticeai/equinox-client-ui-primitives": "workspace:^",
    "@solsticeai/equinox-client-ui-renderer": "workspace:^",
    "@solsticeai/equinox-client-ui-settings": "workspace:^",
    "@solsticeai/equinox-client-ui-slots": "workspace:^",
    "@types/react": "~19.2.18",
    "react": "^19.2.8",
    "@solsticeai/equinox-client-connection": "workspace:^",
    "@solsticeai/equinox-settings": "workspace:^"
  },
  "dependencies": {
    "@solsticeai/schemastery": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
