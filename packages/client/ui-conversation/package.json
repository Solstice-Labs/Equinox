{
  "name": "@solsticeai/equinox-client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0",
    "@solsticeai/schemastery": "workspace:^",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "lexical": "^0.49.0"
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-api-remotes": "workspace:^",
    "@solsticeai/equinox-api-session-controller": "workspace:^",
    "@solsticeai/equinox-api-workspace-controller": "workspace:^",
    "@solsticeai/equinox-attachment": "workspace:^",
    "@solsticeai/equinox-brand": "workspace:^",
    "@solsticeai/equinox-client-locale": "workspace:^",
    "@solsticeai/equinox-client-store": "workspace:^",
    "@solsticeai/equinox-client-test-runtime": "workspace:^",
    "@solsticeai/equinox-client-ui-layout": "workspace:^",
    "@solsticeai/equinox-client-ui-primitives": "workspace:^",
    "@solsticeai/equinox-client-ui-renderer": "workspace:^",
    "@solsticeai/equinox-client-ui-session": "workspace:^",
    "@solsticeai/equinox-client-ui-settings": "workspace:^",
    "@solsticeai/equinox-client-ui-workspace": "workspace:^",
    "@solsticeai/equinox-client-ui-slots": "workspace:^",
    "@solsticeai/equinox-commands": "workspace:^",
    "@solsticeai/equinox-goal": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-llm-retry": "workspace:^",
    "@solsticeai/equinox-permission-presets": "workspace:^",
    "@solsticeai/equinox-plan-mode": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-token-meter": "workspace:^",
    "@solsticeai/equinox-tool-todo": "workspace:^",
    "@solsticeai/equinox-util-crypto": "workspace:^",
    "@solsticeai/equinox-workspace": "workspace:^",
    "@solsticeai/equinox-util-workspace-path": "workspace:^",
    "@types/react": "~19.2.18",
    "react": "^19.2.8",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "@types/react-dom": "~18.3.0",
    "zod": "^4.4.3",
    "@solsticeai/equinox-settings": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
