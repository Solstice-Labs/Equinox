{
  "name": "@solsticeai/equinox-client-ui-jobs",
  "description": "Session-header background-job list: live registry state mirrored from session/jobs frames",
  "version": "0.1.2-alpha.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/client/ui-jobs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/equinox-client-locale": "workspace:^",
    "@solsticeai/equinox-client-test-runtime": "workspace:^",
    "@solsticeai/equinox-client-ui-conversation": "workspace:^",
    "@solsticeai/equinox-client-ui-primitives": "workspace:^",
    "@solsticeai/equinox-client-ui-slots": "workspace:^",
    "@types/react": "~19.2.18",
    "@solsticeai/cordis": "workspace:^",
    "react": "^19.2.8",
    "@solsticeai/equinox-api-session-controller": "workspace:^",
    "@solsticeai/equinox-client-ui-renderer": "workspace:^",
    "@solsticeai/equinox-client-ui-session": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
