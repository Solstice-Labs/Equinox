{
  "name": "@solsticeai/equinox-client-ui-settings-general",
  "description": "Settings ownerless-copy and product onboarding plugin: the General section, shell trigger/header chrome content, settings dictionaries, and the versioned welcome notice",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/client/ui-settings-general"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@solsticeai/schemastery": "workspace:^",
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/equinox-api-remotes": "workspace:^",
    "@solsticeai/equinox-client-connection": "workspace:^",
    "@solsticeai/equinox-client-locale": "workspace:^",
    "@solsticeai/equinox-client-store": "workspace:^",
    "@solsticeai/equinox-client-test-runtime": "workspace:^",
    "@solsticeai/equinox-client-ui-primitives": "workspace:^",
    "@solsticeai/equinox-client-ui-settings": "workspace:^",
    "@solsticeai/equinox-client-ui-sidebar": "workspace:^",
    "@solsticeai/equinox-client-ui-slots": "workspace:^",
    "@solsticeai/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@solsticeai/equinox-client-ui-renderer": "workspace:^",
    "@solsticeai/equinox-client-ui-session": "workspace:^",
    "@solsticeai/equinox-settings": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
