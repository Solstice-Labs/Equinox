{
  "name": "@solsticeai/equinox-time-context",
  "description": "Opt-in durable per-step context with the current time and elapsed time",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/context/time-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@solsticeai/equinox-util-values": "workspace:^",
    "@solsticeai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-invariants": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-agent-loop": "workspace:^",
    "@solsticeai/equinox-agent-loop-testkit": "workspace:^",
    "@solsticeai/equinox-app-boot": "workspace:^",
    "@solsticeai/equinox-bash-local": "workspace:^",
    "@solsticeai/equinox-invariants": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-loader-smoke": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-checkpoint-policy": "workspace:^",
    "@solsticeai/equinox-session-persistence-jsonl": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^",
    "@solsticeai/equinox-subprocess-local": "workspace:^",
    "@solsticeai/equinox-system-prompt": "workspace:^",
    "@solsticeai/equinox-tools": "workspace:^"
  }
}
