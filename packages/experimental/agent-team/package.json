{
  "name": "@solsticeai/equinox-experimental-agent-team",
  "description": "Implicit-root Agent Teams roster, durable peer mailbox, and shared task DAG",
  "version": "0.1.2-alpha.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/experimental/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@solsticeai/equinox-brand": "workspace:^",
    "@solsticeai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-invariants": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-persistence": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^",
    "@solsticeai/equinox-subagent": "workspace:^",
    "@solsticeai/equinox-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-agent-loop": "workspace:^",
    "@solsticeai/equinox-agent-loop-testkit": "workspace:^",
    "@solsticeai/equinox-invariants": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-persistence": "workspace:^",
    "@solsticeai/equinox-session-persistence-jsonl": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^",
    "@solsticeai/equinox-session-query": "workspace:^",
    "@solsticeai/equinox-subagent": "workspace:^",
    "@solsticeai/equinox-subagent-fork-in-process": "workspace:^",
    "@solsticeai/equinox-subagent-spawn-in-process": "workspace:^",
    "@solsticeai/equinox-typert-protocol": "workspace:^"
  }
}
