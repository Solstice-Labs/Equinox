{
  "name": "@solsticeai/equinox-experimental-inspector",
  "description": "Experimental cross-realm CDP hub for Host debugging and Client Runtime inspection",
  "version": "0.1.2-alpha.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/experimental/inspector"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@solsticeai/equinox-brand": "workspace:^",
    "@solsticeai/equinox-util-crypto": "workspace:^",
    "@solsticeai/schemastery": "workspace:^",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/cordis-plugin-loader": "workspace:^",
    "@solsticeai/equinox-client-modules": "workspace:^",
    "@solsticeai/equinox-host-webserver": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/cordis-plugin-include": "workspace:^",
    "@solsticeai/cordis-plugin-loader": "workspace:^",
    "@solsticeai/equinox-host-webserver": "workspace:^",
    "@types/ws": "^8.18.1",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2"
  }
}
