    "@solsticeai/equinox-invariants": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-persistence": "workspace:^",
    "@solsticeai/equinox-session-persistence-jsonl": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^",
    "@solsticeai/equinox-system-prompt": "workspace:^",
    "@solsticeai/equinox-tools": "workspace:^",
    "@solsticeai/cordis": "workspace:^"
