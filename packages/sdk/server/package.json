{
  "name": "@solsticeai/equinox-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@solsticeai/equinox-brand": "workspace:^",
    "@solsticeai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-attachment": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-llm-deepseek": "workspace:^",
    "@solsticeai/equinox-scope": "workspace:^",
    "@solsticeai/equinox-sdk-protocol": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-subagent": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/cordis-plugin-loader": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-agent-loop": "workspace:^",
    "@solsticeai/equinox-agent-loop-testkit": "workspace:^",
    "@solsticeai/equinox-attachment": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-llm-deepseek": "workspace:^",
    "@solsticeai/equinox-scope": "workspace:^",
    "@solsticeai/equinox-sdk-protocol": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-persistence-jsonl": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^",
    "@solsticeai/equinox-subagent": "workspace:^"
  }
}
