{
  "name": "@solsticeai/equinox-bash-sandbox",
  "description": "Sandbox-consuming implementation of the DeepSeek Harness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@solsticeai/equinox-shell": "workspace:^",
    "@solsticeai/equinox-bash-local": "workspace:^",
    "@solsticeai/equinox-sandbox": "workspace:^",
    "@solsticeai/equinox-sandbox-policy": "workspace:^",
    "@solsticeai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/equinox-shell": "workspace:^",
    "@solsticeai/equinox-bash-local": "workspace:^",
    "@solsticeai/equinox-subprocess-local": "workspace:^",
    "@solsticeai/equinox-sandbox": "workspace:^",
    "@solsticeai/equinox-sandbox-local": "workspace:^",
    "@solsticeai/equinox-sandbox-policy": "workspace:^",
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/node-addon-landlock-run": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^"
  }
}
