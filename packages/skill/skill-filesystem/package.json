    "@solsticeai/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "@solsticeai/schemastery": "workspace:^",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@solsticeai/equinox-fs": "workspace:^",
    "@solsticeai/equinox-home-paths": "workspace:^",
    "@solsticeai/equinox-skill": "workspace:^",
    "@solsticeai/cordis": "workspace:^"
