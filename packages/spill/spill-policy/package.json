{
  "name": "@solsticeai/equinox-spill-policy",
  "description": "Tool-result spill policy for the DeepSeek Harness — replaces oversized plain-text tool results with a retained preview plus a spill-file path (no service API)",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-output-retention": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-spill": "workspace:^",
    "@solsticeai/equinox-tools": "workspace:^",
    "@solsticeai/cordis": "workspace:^"
  },
  "dependencies": {
    "@solsticeai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-code-runtime-worker-thread": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-output-retention": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-spill": "workspace:^",
    "@solsticeai/equinox-tools": "workspace:^",
    "@solsticeai/cordis": "workspace:^"
  }
}
