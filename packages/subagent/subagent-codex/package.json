{
  "name": "@solsticeai/equinox-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-subagent": "workspace:^",
    "@solsticeai/equinox-subprocess": "workspace:^",
    "@solsticeai/equinox-timeout": "workspace:^"
  },
  "dependencies": {
    "@solsticeai/equinox-brand": "workspace:^",
    "@solsticeai/equinox-sdk-protocol": "workspace:^",
    "@solsticeai/schemastery": "workspace:^",
    "@openai/codex": "0.149.1"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/cordis-plugin-loader": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-app-boot": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-loader-smoke": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-checkpoint-policy": "workspace:^",
    "@solsticeai/equinox-session-persistence-jsonl": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^",
    "@solsticeai/equinox-subagent": "workspace:^",
    "@solsticeai/equinox-subprocess": "workspace:^",
    "@solsticeai/equinox-subprocess-local": "workspace:^",
    "@solsticeai/equinox-timeout": "workspace:^",
    "@solsticeai/equinox-tool-jobs": "workspace:^",
    "@solsticeai/equinox-tool-subagent": "workspace:^",
    "@solsticeai/equinox-tools": "workspace:^"
  }
}
