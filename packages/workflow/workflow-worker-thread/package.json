{
  "name": "@solsticeai/equinox-workflow-worker-thread",
  "description": "worker-thread workflow engine: executes model-written orchestration scripts off the host event loop, bridging agent() calls back to ctx.subagents",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstice-Labs/Equinox.git",
    "directory": "packages/workflow/workflow-worker-thread"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-subagent": "workspace:^",
    "@solsticeai/equinox-tools": "workspace:^",
    "@solsticeai/equinox-workflow": "workspace:^"
  },
  "dependencies": {
    "@solsticeai/equinox-brand": "workspace:^",
    "@solsticeai/equinox-util-values": "workspace:^",
    "@solsticeai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@solsticeai/cordis": "workspace:^",
    "@solsticeai/equinox-agent": "workspace:^",
    "@solsticeai/equinox-agent-loop": "workspace:^",
    "@solsticeai/equinox-agent-loop-testkit": "workspace:^",
    "@solsticeai/equinox-invariants": "workspace:^",
    "@solsticeai/equinox-llm": "workspace:^",
    "@solsticeai/equinox-session": "workspace:^",
    "@solsticeai/equinox-session-projection": "workspace:^",
    "@solsticeai/equinox-subagent": "workspace:^",
    "@solsticeai/equinox-subagent-spawn-in-process": "workspace:^",
    "@solsticeai/equinox-system-prompt": "workspace:^",
    "@solsticeai/equinox-tools": "workspace:^",
    "@solsticeai/equinox-workflow": "workspace:^",
    "tsx": "^4.19.2"
  }
}
