{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@solsticeai/core": ["packages/core/equinox-core/src/index.ts"],
      "@solsticeai/lightning": ["packages/core/equinox-lightning/src/index.ts"],
      "@solsticeai/client": ["packages/client/equinox-client/src/index.ts"],
      "@solsticeai/profiler": ["packages/profiler/equinox-profiler/src/index.ts"],
      "@solsticeai/tools": ["packages/tools/equinox-tools/src/index.ts"],
      "@solsticeai/adapter": ["packages/adapter/equinox-adapter/src/index.ts"],
      "@solsticeai/distiller": ["packages/distiller/equinox-distiller/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "vitest.config.ts"]
}